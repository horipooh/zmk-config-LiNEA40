#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        finder {
            bindings = <&kp RS(RA(RC(RG(F))))>;
            key-positions = <16 17 18 19>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        horipu: horipu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp O &kp R &kp I &kp P &kp U &kp RET>;
            label = "HORIPU";
        };

        Horipu0811: Horipu0811 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(H) &kp O &kp R &kp I &kp P &kp U &kp N0 &kp N8 &kp N1 &kp N1>;
            label = "HORIPU0811";
        };

        Horipu630811: Horipu630811 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(H) &kp O &kp R &kp I &kp P &kp U &kp N6 &kp N3 &kp N0 &kp N8 &kp N1 &kp N1>;
            label = "HORIPU630811";
        };

        to_ZFold: to_ZFold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&macro_wait_time 200>, <&to 7>;

            label = "TO_ZFOLD";
        };

        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 0>;

            label = "TO_MAC";
        };

        to_macmini: to_macmini {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 200>, <&to 0>;

            label = "TO_MACMINI";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt ESC Q         &kp W         &kp E               &kp R                   &kp T                                  &kp Y          &kp U  &kp I             &kp O           &kp P
&kp A             &kp S         &kp D               &kp F                   &kp G                                  &kp H          &kp J  &kp K             &kp L           &kp RET
&mt LEFT_SHIFT Z  &kp X         &kp C               &kp V                   &kp B                                  &kp N          &kp M  &kp COMMA         &kp UP_ARROW    &mt RIGHT_SHIFT PERIOD
&kp LCTRL         &kp LEFT_ALT  &mt LEFT_GUI LANG1  &mt LEFT_COMMAND LANG1  &lt 2 SPACE  &lt 3 LANG2    &kp MINUS  &kp BACKSPACE         &lt 6 LEFT_ARROW  &kp DOWN_ARROW  &mt RIGHT_SHIFT RIGHT_ARROW
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans    &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp EXCL     &kp N7        &kp N8        &kp N9        &kp COLON                      &kp LA(LC(LEFT_ARROW))  &kp LA(LC(D))  &kp LA(LC(RET))  &kp LA(LC(T))  &kp LA(LC(RIGHT_ARROW))
&kp PLUS     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp HASH                       &kp LEFT_PARENTHESIS    &mkp MB1       &trans           &mkp MB2       &trans
&kp COMMA    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp AT_SIGN                    &kp RIGHT_PARENTHESIS   &trans         &kp SLASH        &trans         &kp QUESTION
&kp PERCENT  &kp N0        &kp PERIOD    &trans        &trans       &trans    &trans  &trans                                 &trans           &trans         &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        //3

        MACRO {
            bindings = <
&trans  &trans  &trans         &kp LG(F10)  &kp LA(LS(LG(SEMI)))                                &trans               &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans       &kp LG(LA(LS(N0)))                                  &kp RC(UP_ARROW)     &trans  &trans  &trans  &trans
&trans  &trans  &Horipu630811  &Horipu0811  &horipu                                             &kp LC(DOWN_ARROW)   &trans  &trans  &trans  &trans
&trans  &trans  &trans         &trans       &kp LG(LS(NUMBER_4))  &trans    &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)          &trans  &trans  &trans
            >;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                     &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                    &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))
&trans  &trans  &trans  &kp F11  &kp F12                    &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &trans    &trans  &trans              &trans               &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &to_mac         &bt BT_SEL 1  &to_macmini  &bt BT_SEL 3  &to_ZFold
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans       &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans       &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans       &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        ZFold {
            bindings = <
&trans  &trans  &trans           &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans           &trans  &trans                    &trans  &trans  &trans  &trans  &kp LS(RET)
&trans  &trans  &trans           &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mt LCTRL LANG1  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };
    };
};
